{
    "baseUrl": "https://www.adspendspy.com/api/v1",
    "headers": {
        "Authorization": "Bearer {{connection.apiKey}}"
    },
    "response": {
        "error": {
            "402": {
                "message": "AdSpendSpy automations need a paid plan."
            },
            "message": "[{{statusCode}}] {{body.message}}"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.authorization"
        ]
    }
}
