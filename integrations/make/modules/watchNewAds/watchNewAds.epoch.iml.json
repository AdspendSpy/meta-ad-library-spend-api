{
    "url": "/ads/new.php",
    "method": "GET",
    "qs": {
        "limit": 100
    },
    "response": {
        "limit": 300,
        "iterate": "{{body.items}}",
        "output": {
            "label": "{{item.brand.name}} – {{item.ad.headline}} (#{{item.ad.internal_ad_id}})",
            "id": "{{item.ad.internal_ad_id}}"
        }
    }
}
